# Deployment hostname. Point its DNS A/AAAA records to this server first.
AGENTFLOW_DOMAIN=agent.example.com

# Dashboard Basic Auth username and password (password must be 16+ characters).
AGENTFLOW_USERNAME=admin
AGENTFLOW_PASSWORD=replace-with-a-long-random-password

# Add only the providers and bot that you will use. Keys stay server-side.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_SEARCH_KEY=
TELEGRAM_BOT_TOKEN=

# PostgreSQL connection string for the migration/import utilities.
# The current application runtime still uses SQLite.
DATABASE_URL=
