# Deployment hostname. Point its DNS A/AAAA records to this server first.
AGENTFLOW_DOMAIN=agent.example.com

# Dashboard Basic Auth username and password (password must be 16+ characters).
AGENTFLOW_USERNAME=admin
AGENTFLOW_PASSWORD=replace-with-a-long-random-password

# Add only the providers and bot that you will use. Keys stay server-side.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_SEARCH_KEY=
TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=
YOUTUBE_API_KEY=

# YouTube Analytics OAuth (Google Cloud OAuth client type: Web application).
# GOOGLE_CLIENT_ID/SECRET/REDIRECT_URI are the preferred variable names.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default: http://localhost:3001/api/digital-footprint/youtube/oauth/callback
# On Render, the callback defaults to https://$RENDER_EXTERNAL_HOSTNAME/api/digital-footprint/youtube/oauth/callback.
GOOGLE_REDIRECT_URI=
# Legacy aliases remain supported:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Optional if the server can write its private secret file; set explicitly for durable deployments.
YOUTUBE_OAUTH_TOKEN_ENCRYPTION_KEY=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required only for the legacy AES-encrypted dashboard credential form.
PSIT_ERP_CREDENTIAL_ENCRYPTION_KEY=
PSIT_ERP_BASE_URL=https://erp.psit.ac.in/Erp/
PSIT_ERP_USER_ID=
PSIT_ERP_PASSWORD=
PSIT_ERP_SYNC_INTERVAL_MINUTES=15
# Optional bearer secret for an external scheduler that wakes a sleeping Render instance.
AGENTFLOW_PSIT_ERP_CRON_SECRET=

# Bearer secrets for the authenticated external news and companion cron endpoints.
AGENTFLOW_NEWS_CRON_SECRET=
AGENTFLOW_COMPANION_CRON_SECRET=
AGENTFLOW_FOOTPRINT_CRON_SECRET=

# Calendarific holiday calendar key (https://calendarific.com/register).
CALENDARIFIC_API_KEY=

# Optional job extraction limits. Prompt tokens are estimated conservatively
# and capped below the model context window; output generation reserves 2,000 tokens.
AGENTFLOW_JOB_PROMPT_TOKEN_BUDGET=6000
AGENTFLOW_JOB_DESCRIPTION_MAX_CHARS=8000

# PostgreSQL connection string for durable Personal Companion settings, events,
# notification history, festival dates, and scheduler runs.
DATABASE_URL=
